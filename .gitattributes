# Keep line endings consistent on Windows, macOS and Linux.
# Files are stored in Git with LF, and checked out with LF everywhere.
* text=auto eol=lf

# Batch files must keep CRLF or cmd.exe can misread them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never normalised, diffed or merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.mp3 binary
*.mp4 binary
